{
  "name": "monarch",
  "version": "0.1.0",
  "description": "A shared move-in and move-out condition record for rentals",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node --env-file=.env src/server.js",
    "migrate": "node --env-file=.env src/db/migrate.js",
    "migrate:test": "NODE_ENV=test node --env-file=.env src/db/migrate.js",
    "db:roles": "node --env-file=.env src/db/roles.js",
    "db:roles:test": "NODE_ENV=test node --env-file=.env src/db/roles.js",
    "seed:demo": "node --env-file=.env scripts/seed-demo.js",
    "test": "NODE_ENV=test node --env-file=.env --test --test-concurrency=1 'tests/**/*.test.js'",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": ""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.0.0",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.1",
    "globals": "^15.15.0",
    "prettier": "^3.5.1",
    "supertest": "^7.0.0"
  }
}
